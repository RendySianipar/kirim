+        app.kubernetes.io/name: kafka
+    spec:
+      # Without this, Kubernetes injects KAFKA_PORT, KAFKA_SERVICE_HOST, ... for the
+      # "kafka" Service, and the image would read them as broker settings.
+      enableServiceLinks: false
+      securityContext:
+        fsGroup: 1000 # the image runs as uid 1000 and must own the data volume
+      containers:
+        - name: kafka
+          image: apache/kafka:3.9.0
+          ports:
+            - name: client
+              containerPort: 9092
+            - name: controller
+              containerPort: 9093
+          env:
+            - name: KAFKA_NODE_ID
+              value: "1"
+            - name: KAFKA_PROCESS_ROLES
+              value: broker,controller
+            - name: KAFKA_LISTENERS
+              value: PLAINTEXT://:9092,CONTROLLER://:9093
+            - name: KAFKA_ADVERTISED_LISTENERS
+              value: PLAINTEXT://kafka:9092
+            - name: KAFKA_LISTENER_SECURITY_PROTOCOL_MAP
+              value: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
+            - name: KAFKA_CONTROLLER_LISTENER_NAMES
+              value: CONTROLLER
+            - name: KAFKA_INTER_BROKER_LISTENER_NAME
+              value: PLAINTEXT
+            - name: KAFKA_CONTROLLER_QUORUM_VOTERS
+              value: 1@localhost:9093
+            - name: KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR
+              value: "1"
+            - name: KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR
+              value: "1"
+            - name: KAFKA_TRANSACTION_STATE_LOG_MIN_ISR
+              value: "1"
+            - name: KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS
+              value: "0"
+            - name: KAFKA_LOG_DIRS
+              value: /var/lib/kafka/data
+          readinessProbe:
+            tcpSocket:
+              port: client
+            periodSeconds: 5
+          livenessProbe:
+            tcpSocket:
+              port: client
+            initialDelaySeconds: 60
+            periodSeconds: 10
+          resources:
+            requests:
+              cpu: 250m
+              memory: 768Mi
+            limits:
+              memory: 1Gi
+          volumeMounts:
+            - name: data
+              mountPath: /var/lib/kafka/data
+  volumeClaimTemplates:
+    - metadata:
+        name: data
+      spec:
+        accessModes: ["ReadWriteOnce"]
+        resources:
+          requests:
+            storage: 2Gi
diff --git a/deploy/k8s/base/kirim-api.yaml b/deploy/k8s/base/kirim-api.yaml
new file mode 100644
index 0000000..33801f4
--- /dev/null
+++ b/deploy/k8s/base/kirim-api.yaml
@@ -0,0 +1,129 @@
+# The transfer API. Two replicas is safe by design:
+#  - the outbox relay claims rows with FOR UPDATE SKIP LOCKED, so instances never send the same event twice at once
+#  - the rate-limit counters live in Redis, shared by every replica
+#  - the notification consumer is one Kafka consumer group, partitions are split between replicas
+apiVersion: v1
+kind: Service
+metadata:
+  name: kirim-api
+  labels:
+    app.kubernetes.io/name: kirim-api
+spec:
+  selector:
+    app.kubernetes.io/name: kirim-api
+  ports:
+    - name: http
+      port: 80
+      targetPort: http
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: kirim-api
+  labels:
+    app.kubernetes.io/name: kirim-api
+spec:
+  replicas: 2
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0 # never drop below the desired count during a deploy
+      maxSurge: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: kirim-api
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: kirim-api
+      annotations:
+        prometheus.io/scrape: "true"
+        prometheus.io/path: /actuator/prometheus
+        prometheus.io/port: "8080"
+    spec:
+      terminationGracePeriodSeconds: 40
+      affinity:
+        podAntiAffinity:
+          preferredDuringSchedulingIgnoredDuringExecution:
+            - weight: 100
+              podAffinityTerm:
+                topologyKey: kubernetes.io/hostname
+                labelSelector:
+                  matchLabels:
+                    app.kubernetes.io/name: kirim-api
+      containers:
+        - name: api
+          image: kirim-api
+          imagePullPolicy: IfNotPresent
+          ports:
+            - name: http
+              containerPort: 8080
+          envFrom:
+            - configMapRef:
+                name: kirim-api-config
+          env:
+            - name: SPRING_DATASOURCE_USERNAME
+              valueFrom:
+                secretKeyRef:
+                  name: kirim-db
+                  key: username
+            - name: SPRING_DATASOURCE_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: kirim-db
+                  key: password
+          # Spring Boot exposes these groups when it detects Kubernetes (and via
+          # management.endpoint.health.probes.enabled). Readiness checks PostgreSQL
+          # only; see application.yml for why Redis is left out.
+          startupProbe:
+            httpGet:
+              path: /actuator/health/liveness
+              port: http
+            periodSeconds: 5
+            failureThreshold: 30 # up to 150s for JVM start + Flyway
+          livenessProbe:
+            httpGet:
+              path: /actuator/health/liveness
+              port: http
+            periodSeconds: 10
+            failureThreshold: 3
+          readinessProbe:
+            httpGet:
+              path: /actuator/health/readiness
+              port: http
+            periodSeconds: 5
+            failureThreshold: 3
+          lifecycle:
+            preStop:
+              # Give the Service time to stop routing here before Spring starts its graceful shutdown.
+              exec:
+                command: ["sleep", "10"]
+          resources:
+            requests:
+              cpu: 250m
+              memory: 512Mi
+            limits:
+              memory: 768Mi
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 1001
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp # Tomcat's work directory; the rest of the filesystem is read-only
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: kirim-api
+spec:
+  minAvailable: 1 # node drains and cluster upgrades keep at least one API pod serving
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: kirim-api
