diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000..d433d41
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,164 @@
+# GitLab CI/CD for Kirim: test -> build images -> deploy to Kubernetes.
+#
+# Needs, in the GitLab project:
+#   - a GitLab agent for Kubernetes connected to the target cluster; put its
+#     context ("<project path>:<agent name>") in the KUBE_CONTEXT CI/CD variable
+#   - a deploy token named "gitlab-deploy-token" with read_registry, so GitLab
+#     provides CI_DEPLOY_USER / CI_DEPLOY_PASSWORD for the image pull secret
+# Merge requests run the tests; the default branch also builds and pushes the
+# images, and deploying is a manual button on the pipeline.
+
+stages:
+  - test
+  - build
+  - deploy
+
+variables:
+  # Testcontainers talks to the Docker-in-Docker service instead of a local socket.
+  DOCKER_HOST: tcp://docker:2375
+  DOCKER_TLS_CERTDIR: ""
+  TESTCONTAINERS_HOST_OVERRIDE: docker
+  TESTCONTAINERS_RYUK_DISABLED: "true"
+  GRADLE_OPTS: "-Dorg.gradle.daemon=false"
+  API_IMAGE: $CI_REGISTRY_IMAGE/api
+  RISK_IMAGE: $CI_REGISTRY_IMAGE/risk-service
+
+workflow:
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+
+# ---------------------------------------------------------------- test
+
+.gradle-test:
+  stage: test
+  image: eclipse-temurin:21-jdk
+  services:
+    - name: docker:27-dind
+      alias: docker
+  variables:
+    GRADLE_USER_HOME: $CI_PROJECT_DIR/.gradle-home
+  cache:
+    key: gradle-$CI_JOB_NAME
+    paths:
+      - .gradle-home/caches/
+      - .gradle-home/wrapper/
+  script:
+    - cd "$SERVICE_DIR"
+    - chmod +x gradlew
+    # Unit tests + Testcontainers integration tests against real PostgreSQL, Kafka and Redis.
+    - ./gradlew build
+  artifacts:
+    when: always
+    reports:
+      junit: $SERVICE_DIR/build/test-results/test/TEST-*.xml
+    paths:
+      - $SERVICE_DIR/build/reports/tests/test/
+    expire_in: 1 week
+
+backend:test:
+  extends: .gradle-test
+  variables:
+    SERVICE_DIR: backend
+
+risk-service:test:
+  extends: .gradle-test
+  variables:
+    SERVICE_DIR: risk-service
+
+web:test:
+  stage: test
+  image: node:22
+  cache:
+    key:
+      files:
+        - web/package-lock.json
+    paths:
+      - web/.npm/
+  script:
+    - cd web
+    - npm ci --cache .npm --prefer-offline
+    - npm run lint
+    - npm test
+    - npm run build
+
+manifests:validate:
+  stage: test
+  image:
+    # The image used in GitLab's agent-for-Kubernetes docs; pin a digest for reproducible deploys.
+    name: bitnami/kubectl:latest
+    entrypoint: [""]
+  script:
+    # Renders both overlays; a typo in a manifest fails here, not during a deploy.
+    - kubectl kustomize deploy/k8s/overlays/local > /dev/null
+    - kubectl kustomize deploy/k8s/overlays/gitlab > /dev/null
+
+# ---------------------------------------------------------------- build
+
+.image-build:
+  stage: build
+  image: docker:27
+  services:
+    - name: docker:27-dind
+      alias: docker
+  rules:
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+  before_script:
+    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
+  script:
+    # Tagged with the commit SHA, so every deploy is traceable and can be rolled back to an exact build.
+    - docker build -t "$IMAGE:$CI_COMMIT_SHORT_SHA" "$SERVICE_DIR"
+    - docker push "$IMAGE:$CI_COMMIT_SHORT_SHA"
+
+api:image:
+  extends: .image-build
+  needs: ["backend:test"]
+  variables:
+    IMAGE: $API_IMAGE
+    SERVICE_DIR: backend
+
+risk-service:image:
+  extends: .image-build
+  needs: ["risk-service:test"]
+  variables:
+    IMAGE: $RISK_IMAGE
+    SERVICE_DIR: risk-service
+
+# ---------------------------------------------------------------- deploy
+
+deploy:staging:
+  stage: deploy
+  image:
+    # The image used in GitLab's agent-for-Kubernetes docs; pin a digest for reproducible deploys.
+    name: bitnami/kubectl:latest
+    entrypoint: [""]
+  needs: ["api:image", "risk-service:image", "manifests:validate"]
+  rules:
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+      when: manual
+  environment:
+    name: staging
+  resource_group: staging # one deploy at a time
+  script:
+    - kubectl config use-context "$KUBE_CONTEXT"
+    - kubectl apply -f deploy/k8s/base/namespace.yaml
+    # Pull secret for the private GitLab registry (idempotent: create or update).
+    - >
+      kubectl -n kirim create secret docker-registry gitlab-registry
+      --docker-server="$CI_REGISTRY" --docker-username="$CI_DEPLOY_USER" --docker-password="$CI_DEPLOY_PASSWORD"
+      --dry-run=client -o yaml | kubectl apply -f -
+    # Point the overlay at this commit's images.
+    - |
+      cat >> deploy/k8s/overlays/gitlab/kustomization.yaml <<EOF
+      images:
+        - name: kirim-api
+          newName: $API_IMAGE
+          newTag: "$CI_COMMIT_SHORT_SHA"
+        - name: kirim-risk-service
+          newName: $RISK_IMAGE
+          newTag: "$CI_COMMIT_SHORT_SHA"
+      EOF
+    - kubectl apply -k deploy/k8s/overlays/gitlab
+    # Fail the job if the new pods don't become ready (bad config, failing migration, crash loop).
+    - kubectl -n kirim rollout status deployment/kirim-api --timeout=300s
+    - kubectl -n kirim rollout status deployment/risk-service --timeout=300s
